# Скопіюйте у .env (кореневий, не комітиться) і заповніть.

# Ключі зовнішніх API
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Ліцензія Remotion (Company License); порожньо — локальна розробка
REMOTION_LICENSE_KEY=

# Пароль на вхід (HTTP Basic). Порожній = без авторизації (лише локально!)
APP_PASSWORD=

# Інфраструктура
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./.data
PORT=3000

# Довідкова ціль вартості одного відео, USD (лише позначка в /stats)
COST_TARGET_USD=3.5
