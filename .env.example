# Скопіюйте у .env (кореневий, не комітиться) і заповніть.

# Ключі зовнішніх API
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Ключ Partner API Epidemic Sound (epidemic_live_…), безкоштовний тариф — 50 завантажень, лише прототип
# (ADC_MUSIC_PROVIDER=epidemic / ADC_SFX_PROVIDER=epidemic)
EPIDEMIC_API_KEY=
# Ліцензія Remotion (Company License); порожньо — локальна розробка
REMOTION_LICENSE_KEY=

# Акаунти. E-mail адміністраторів через кому; роль обчислюється на кожен запит (не зберігається)
ADMIN_EMAILS=
# База для посилань у листах і checkout (на сервері — https://<APP_DOMAIN>)
APP_URL=http://localhost:3000
# Опційний staging-gate (HTTP Basic) поверх акаунтів; порожній — лише сесії
APP_PASSWORD=

# Інфраструктура
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./.data
PORT=3000

# Довідкова ціль вартості одного відео, USD (лише позначка в /stats)
COST_TARGET_USD=3.5
